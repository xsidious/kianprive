enum VendorPayableStatus {
  OPEN
  SENT
  PAID
  CANCELED
}

model Vendor {
  id             String          @id @default(cuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  paymentMethod  String?
  payoutDetails  Json?
  notes          String?
  products       Product[]
  vendorOffers   ProductVendorOffer[]
  payables       VendorPayable[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ProductVendorOffer {
  id           String   @id @default(cuid())
  productId    String
  vendorId     String
  unitCost     Decimal  @db.Decimal(10, 2)
  shippingCost Decimal  @default(0) @db.Decimal(10, 2)
  vendorSku    String?
  notes        String?
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, vendorId])
  @@index([vendorId])
  @@index([productId])
}

model VendorPayable {
  id            String              @id @default(cuid())
  vendorId      String
  orderId       String
  status        VendorPayableStatus @default(OPEN)
  amount        Decimal             @db.Decimal(10, 2)
  currency      String              @default("USD")
  reference     String              @unique
  notes         String?
  sentAt        DateTime?
  paidAt        DateTime?
  paidReference String?
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([vendorId, status])
  @@index([orderId])
}

enum TherapyBillingInterval {
  ONE_TIME
  WEEKLY
  EVERY_2_WEEKS
  EVERY_4_WEEKS
  MONTHLY
  EVERY_6_WEEKS
  EVERY_8_WEEKS
  CUSTOM
}

enum TherapySubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELED
}

model TherapySubscription {
  id                   String                     @id @default(cuid())
  proposalId           String                     @unique
  intakeSubmissionId   String
  status               TherapySubscriptionStatus  @default(PENDING)
  interval             TherapyBillingInterval
  intervalDays         Int
  amount               Decimal                    @db.Decimal(10, 2)
  currency             String                     @default("USD")
  email                String?
  nextChargeAt         DateTime?
  lastChargedAt        DateTime?
  startedAt            DateTime?
  canceledAt           DateTime?
  customerProfileId    String?
  paymentProfileId     String?
  cardLast4            String?
  failureCount         Int                        @default(0)
  lastError            String?
  proposal             IntakeTherapyProposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  intakeSubmission     TherapeuticsIntakeSubmission @relation(fields: [intakeSubmissionId], references: [id], onDelete: Cascade)
  orders               Order[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([status, nextChargeAt])
  @@index([intakeSubmissionId])
}
