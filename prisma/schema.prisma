// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String         @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  role            Role           @default(GUEST)
  mustSetPassword Boolean        @default(false)
  memberOnboardingComplete Boolean @default(false)
  setupTokenHash  String?        @unique
  setupTokenExpires DateTime?
  subscription    Subscription?
  profile         Profile?
  partnerProfile  PartnerProfile?
  stripeCustomerId String?       @unique
  accounts        Account[]
  sessions        Session[]
  authoredPosts   BlogPost[]      @relation("BlogPostAuthor")
  editedPosts     BlogPost[]      @relation("BlogPostEditor")
  orders          Order[]
  bookingRequests BookingRequest[]
  therapeuticsIntakes TherapeuticsIntakeSubmission[]
  carts           Cart[]
  pageRevisions   PageRevision[]
  auditLogs       AuditLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model BookingRequest {
  id                String        @id @default(cuid())
  userId            String?
  partnerId         String?
  fullName          String
  email             String
  phone             String
  preferredDate     DateTime
  preferredLocation String
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  timezone          String?       @default("America/New_York")
  notes             String?
  partnerNotes      String?
  serviceIds        String[]
  serviceTitles     String[]
  guestTotal        Decimal       @default(0) @db.Decimal(10, 2)
  memberTotal       Decimal       @default(0) @db.Decimal(10, 2)
  status            BookingStatus @default(PENDING)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  partner           PartnerProfile? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  commissionEntries CommissionLedgerEntry[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([partnerId, status, createdAt])
}

model TherapeuticsIntakeSubmission {
  id                       String                   @id @default(cuid())
  userId                   String?
  fullName                 String
  email                    String
  phone                    String
  dateOfBirth              String
  programs                 String[]
  status                   IntakeSubmissionStatus   @default(PENDING_REVIEW)
  statusNote               String?
  publicTrackingToken      String?                  @unique
  payload                  Json
  referredBy               String?
  clientSignatureDataUrl   String?                  @db.Text
  providerSignatureDataUrl String?                  @db.Text
  providerSignedAt         DateTime?
  providerSignedName       String?
  assignedPartnerId        String?
  user                     User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedPartner          PartnerProfile?          @relation(fields: [assignedPartnerId], references: [id], onDelete: SetNull)
  orders                   Order[]
  messages                 IntakeMessage[]
  therapyProposals         IntakeTherapyProposal[]
  therapySubscriptions     TherapySubscription[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([assignedPartnerId, createdAt])
  @@index([userId, createdAt])
}

enum IntakeTherapyProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  PAID
}

model IntakeTherapyProposal {
  id                 String                      @id @default(cuid())
  intakeSubmissionId String
  providerPartnerId  String
  orderId            String?                     @unique
  status             IntakeTherapyProposalStatus @default(DRAFT)
  notes              String?                     @db.Text
  sentAt             DateTime?
  paidAt             DateTime?
  billingInterval    TherapyBillingInterval @default(ONE_TIME)
  intervalDays       Int?
  intakeSubmission   TherapeuticsIntakeSubmission @relation(fields: [intakeSubmissionId], references: [id], onDelete: Cascade)
  providerPartner    PartnerProfile              @relation(fields: [providerPartnerId], references: [id], onDelete: Cascade)
  order              Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items              IntakeTherapyItem[]
  subscription       TherapySubscription?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([intakeSubmissionId, status])
  @@index([providerPartnerId, createdAt])
}

model IntakeTherapyItem {
  id            String                @id @default(cuid())
  proposalId    String
  productId     String
  quantity      Int                   @default(1)
  unitPrice     Decimal?              @db.Decimal(10, 2)
  titleSnapshot String
  proposal      IntakeTherapyProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([proposalId])
  @@unique([proposalId, productId])
}

enum IntakeMessageAuthor {
  PROVIDER
  PATIENT
  SYSTEM
}

model IntakeMessage {
  id                 String              @id @default(cuid())
  intakeSubmissionId String
  authorRole         IntakeMessageAuthor
  authorUserId       String?
  authorName         String?
  body               String              @db.Text
  createdAt          DateTime            @default(now())
  intakeSubmission   TherapeuticsIntakeSubmission @relation(fields: [intakeSubmissionId], references: [id], onDelete: Cascade)

  @@index([intakeSubmissionId, createdAt])
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  phone              String?
  company            String?
  notes              String?  @db.Text
  dateOfBirth        String?
  medicalConditions  String?  @db.Text
  allergies          String?  @db.Text
  medications        String?  @db.Text
  emergencyContact   String?
  emergencyPhone     String?
  importedNotes      String?  @db.Text
  source             String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 SubscriptionTier   @default(BASIC)
  status               SubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model SiteSetting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NavigationMenu {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  items     MenuItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model MenuItem {
  id          String         @id @default(cuid())
  menuId      String
  parentId    String?
  label       String
  href        String
  target      LinkTarget     @default(SAME_TAB)
  sortOrder   Int            @default(0)
  menu        NavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent      MenuItem?      @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    MenuItem[]     @relation("MenuItemHierarchy")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([menuId, sortOrder])
}

model CmsPage {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  status        ContentStatus @default(DRAFT)
  pageType      String        @default("marketing")
  body          Json
  seoTitle      String?
  seoDescription String?
  seoImage      String?
  canonicalUrl  String?
  noIndex       Boolean       @default(false)
  sections      CmsSection[]
  revisions     PageRevision[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publishedAt   DateTime?
}

model CmsSection {
  id         String    @id @default(cuid())
  pageId     String
  sectionKey String
  sectionType String
  sortOrder  Int       @default(0)
  content    Json
  page       CmsPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([pageId, sortOrder])
}

model PageRevision {
  id         String    @id @default(cuid())
  pageId      String
  editorId    String?
  note        String?
  snapshot    Json
  page        CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor      User?    @relation(fields: [editorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model MediaAsset {
  id          String    @id @default(cuid())
  title       String?
  alt         String?
  mimeType    String?
  storageKey  String?
  url         String
  width       Int?
  height      Int?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BlogCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  posts       BlogPost[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  content        Json
  status         ContentStatus @default(DRAFT)
  categoryId     String?
  authorId       String?
  editorId       String?
  featuredImage  String?
  readTime       String?
  seoTitle       String?
  seoDescription String?
  seoImage       String?
  canonicalUrl   String?
  noIndex        Boolean       @default(false)
  tags           String[]
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author         User?         @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  editor         User?         @relation("BlogPostEditor", fields: [editorId], references: [id], onDelete: SetNull)
}

model ProductCollection {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ProductCatalogKind {
  RETAIL
  CLINICAL
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  description    String?
  status         ProductStatus @default(DRAFT)
  category       String?
  subcategory    String?
  isPrescription Boolean       @default(false)
  catalogKind    ProductCatalogKind @default(RETAIL)
  externalId     String?       @unique
  wholesalePrice Decimal?      @db.Decimal(10, 2)
  form           String?
  strength       String?
  deliveryMethod String?
  source         String?
  featuredImage  String?
  galleryImages  String[]      @default([])
  hasVariants    Boolean       @default(false)
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  currency       String        @default("USD")
  sku            String?       @unique
  inventoryQty   Int           @default(0)
  trackInventory Boolean       @default(true)
  seoTitle       String?
  seoDescription String?
  stripeProductId String?
  stripePriceId  String?
  collectionId   String?
  variants       ProductVariant[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  partnerAssignments PartnerProductAssignment[]
  therapyItems   IntakeTherapyItem[]
  vendorId       String?
  vendor         Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorOffers   ProductVendorOffer[]
  collection     ProductCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([catalogKind, status, category])
  @@index([vendorId])
}

model ProductVariant {
  id            String    @id @default(cuid())
  productId     String
  title         String
  sku           String?   @unique
  price         Decimal   @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  inventoryQty  Int       @default(0)
  image         String?
  options       Json?
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Cart {
  id          String      @id @default(cuid())
  userId      String?
  email       String?
  status      CartStatus  @default(ACTIVE)
  currency    String      @default("USD")
  subtotal    Decimal     @default(0) @db.Decimal(10, 2)
  discountTotal Decimal   @default(0) @db.Decimal(10, 2)
  taxTotal    Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @default(0) @db.Decimal(10, 2)
  items       CartItem[]
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  lineTotal  Decimal  @db.Decimal(10, 2)
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cartId])
}

model Order {
  id                   String       @id @default(cuid())
  orderNumber          String       @unique
  userId               String?
  partnerId            String?
  intakeSubmissionId   String?
  email                String?
  phone                String?
  status               OrderStatus  @default(PENDING)
  paymentStatus        PaymentStatus @default(UNPAID)
  fulfillmentStatus    FulfillmentStatus @default(UNFULFILLED)
  currency             String       @default("USD")
  subtotal             Decimal      @default(0) @db.Decimal(10, 2)
  discountTotal        Decimal      @default(0) @db.Decimal(10, 2)
  taxTotal             Decimal      @default(0) @db.Decimal(10, 2)
  shippingTotal        Decimal      @default(0) @db.Decimal(10, 2)
  total                Decimal      @default(0) @db.Decimal(10, 2)
  shippingAddress      Json?
  billingAddress       Json?
  notes                String?
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId String?     @unique
  authorizeNetTransId  String?      @unique
  paymentToken         String?      @unique
  paymentTokenExpiresAt DateTime?
  items                OrderItem[]
  fulfillments         Fulfillment[]
  payments             PaymentRecord[]
  refunds              RefundRecord[]
  messages             OrderMessage[]
  therapyProposal      IntakeTherapyProposal?
  vendorPayables       VendorPayable[]
  therapySubscriptionId String?
  therapySubscription  TherapySubscription? @relation(fields: [therapySubscriptionId], references: [id], onDelete: SetNull)
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  partner              PartnerProfile? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  intakeSubmission     TherapeuticsIntakeSubmission? @relation(fields: [intakeSubmissionId], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([partnerId, createdAt])
  @@index([intakeSubmissionId])
  @@index([userId, createdAt])
  @@index([therapySubscriptionId])
}

enum OrderMessageAuthor {
  CUSTOMER
  ADMIN
  SYSTEM
}

model OrderMessage {
  id           String             @id @default(cuid())
  orderId      String
  authorRole   OrderMessageAuthor
  authorUserId String?
  authorName   String?
  body         String             @db.Text
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([orderId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  partnerId   String?
  title       String
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  partner     PartnerProfile? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  commissionEntries CommissionLedgerEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([partnerId])
}

model Fulfillment {
  id             String             @id @default(cuid())
  orderId         String
  status          FulfillmentStatus @default(PROCESSING)
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  notes           String?
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model PaymentRecord {
  id                  String        @id @default(cuid())
  orderId             String
  provider            String        @default("stripe")
  status              PaymentStatus @default(UNPAID)
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("USD")
  stripePaymentIntentId String?
  metadata            Json?
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model RefundRecord {
  id             String    @id @default(cuid())
  orderId         String
  amount          Decimal   @db.Decimal(10, 2)
  reason          String?
  stripeRefundId  String?   @unique
  metadata        Json?
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AnalyticsEvent {
  id           String    @id @default(cuid())
  eventName     String
  pagePath      String?
  referrer      String?
  source        String?
  medium        String?
  campaign      String?
  userId        String?
  sessionId     String?
  orderId       String?
  country       String?
  city          String?
  region        String?
  metadata      Json?
  occurredAt    DateTime  @default(now())

  @@index([eventName, occurredAt])
  @@index([pagePath, occurredAt])
  @@index([country, occurredAt])
}

model IdempotencyKey {
  id          String    @id @default(cuid())
  key         String    @unique
  scope       String
  statusCode  Int?
  response    Json?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PartnerProfile {
  id                           String           @id @default(cuid())
  userId                       String           @unique
  displayName                  String
  legalName                    String?
  type                         PartnerType      @default(CLINICAL)
  specialty                    String?
  specialtyTags                String[]         @default([])
  bio                          String?
  phone                        String?
  avatarUrl                    String?
  partnerCode                  String           @unique
  taxId                        String?
  payoutMethod                 String?
  payoutDetails                Json?
  status                       PartnerStatus    @default(INVITED)
  defaultServiceCommissionPct  Decimal          @default(20) @db.Decimal(5, 2)
  defaultProductCommissionPct  Decimal          @default(10) @db.Decimal(5, 2)
  onboardingComplete           Boolean          @default(false)
  user                         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceAssignments           PartnerServiceAssignment[]
  productAssignments           PartnerProductAssignment[]
  bookings                     BookingRequest[]
  orders                       Order[]
  orderItems                   OrderItem[]
  commissionEntries            CommissionLedgerEntry[]
  payouts                      PartnerPayout[]
  guidelineGrants              PartnerGuidelineGrant[]
  guidelineAcks                PartnerGuidelineAck[]
  intakeSubmissions            TherapeuticsIntakeSubmission[]
  therapyProposals             IntakeTherapyProposal[]
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([partnerCode])
}

model PartnerServiceAssignment {
  id             String         @id @default(cuid())
  partnerId      String
  serviceSlug    String
  active         Boolean        @default(true)
  commissionPct  Decimal?       @db.Decimal(5, 2)
  partner        PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([partnerId, serviceSlug])
  @@index([serviceSlug, active])
}

model PartnerProductAssignment {
  id             String         @id @default(cuid())
  partnerId      String
  productId      String
  active         Boolean        @default(true)
  commissionPct  Decimal?       @db.Decimal(5, 2)
  partnerSku     String?
  partner        PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([partnerId, productId])
  @@index([productId, active])
}

model CommissionLedgerEntry {
  id                String              @id @default(cuid())
  partnerId         String
  sourceType        CommissionSourceType
  bookingId         String?
  orderItemId       String?
  description       String?
  grossAmount       Decimal             @db.Decimal(10, 2)
  commissionPct     Decimal             @db.Decimal(5, 2)
  commissionAmount  Decimal             @db.Decimal(10, 2)
  status            CommissionStatus    @default(PENDING)
  earnedAt          DateTime            @default(now())
  payoutId          String?
  partner           PartnerProfile      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  booking           BookingRequest?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  orderItem         OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  payout            PartnerPayout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([partnerId, status, earnedAt])
  @@index([bookingId])
  @@index([orderItemId])
  @@index([payoutId])
}

model PartnerPayout {
  id          String       @id @default(cuid())
  partnerId   String
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal      @default(0) @db.Decimal(10, 2)
  status      PayoutStatus @default(DRAFT)
  paidAt      DateTime?
  exportNote  String?
  partner     PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  entries     CommissionLedgerEntry[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([partnerId, status, createdAt])
}

model PartnerGuideline {
  id          String                  @id @default(cuid())
  title       String
  category    PartnerGuidelineCategory @default(GENERAL)
  body        String?
  documentUrl String?
  version     String                  @default("1.0")
  publishedAt DateTime?
  requiresAck Boolean                 @default(false)
  grants      PartnerGuidelineGrant[]
  acks        PartnerGuidelineAck[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([category, publishedAt])
}

model PartnerGuidelineGrant {
  id           String           @id @default(cuid())
  guidelineId  String
  partnerId    String?
  allPartners  Boolean          @default(false)
  guideline    PartnerGuideline @relation(fields: [guidelineId], references: [id], onDelete: Cascade)
  partner      PartnerProfile?  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@index([guidelineId])
  @@index([partnerId])
}

model PartnerGuidelineAck {
  id           String           @id @default(cuid())
  guidelineId  String
  partnerId    String
  acknowledgedAt DateTime       @default(now())
  guideline    PartnerGuideline @relation(fields: [guidelineId], references: [id], onDelete: Cascade)
  partner      PartnerProfile   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([guidelineId, partnerId])
}

