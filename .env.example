# Copy to `.env` locally (never commit `.env`). In Vercel: Project → Settings → Environment Variables.

# Neon Postgres — paste your full connection string from the Neon dashboard.
# Format: postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require"

# Google account used to sign in to Neon (for your team’s reference only; not used by the app)
NEON_ACCOUNT_EMAIL="privekian8@gmail.com"

# NextAuth (set in Vercel for production)
# Production site: use the canonical URL with no trailing slash, e.g. https://www.kianprive.com
# NEXTAUTH_URL="https://www.kianprive.com"
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32-or-node-crypto"

# Acuity Scheduling (Integrations → API in Acuity dashboard)
# ACUITY_USER_ID="your_numeric_user_id"
# ACUITY_API_KEY="your_api_key"
# ACUITY_SCHEDULER_BASE_URL="https://YourBusiness.as.me"
# ACUITY_SCHEDULING_ENABLED="true"
# ACUITY_BOOK_AS_ADMIN="true"
# Optional per-service overrides: ACUITY_TYPE_NUTRITION=19112766

# Secure notifications (Resend)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="KIAN Prive <contact@keepingitallnatural.com>"
# BOOKING_REPORT_EMAIL="contact@keepingitallnatural.com"
# PEPTIDE_INTAKE_REPORT_EMAIL="contact@keepingitallnatural.com"
# WELLNESS_HUB_INTAKE_REPORT_EMAIL="contact@keepingitallnatural.com,millenniumedgemed@gmail.com"
# (Dr. Carmen Ramirez also always receives Wellness Hub intake alerts at millenniumedgemed@gmail.com)

# Wellness Hub → KIAN Privé intake webhook
# WELLNESS_HUB_INTAKE_SECRET="generate-a-long-random-string"

# Authorize.net (clinical therapy Accept & Pay — not used for retail Stripe shop)
# Leave unset (or THERAPY_PAYMENT_MODE=test) to simulate payments with Visa 4111 1111 1111 1111
# THERAPY_PAYMENT_MODE="test"
# AUTHORIZE_NET_API_LOGIN_ID=""
# AUTHORIZE_NET_TRANSACTION_KEY=""
# AUTHORIZE_NET_ENV="sandbox"
# NEXT_PUBLIC_AUTHORIZE_NET_API_LOGIN_ID=""
# NEXT_PUBLIC_AUTHORIZE_NET_CLIENT_KEY=""
# When ready for real charges: set AuthNet keys and THERAPY_PAYMENT_MODE=live

# Optional: enable Web Analytics + Speed Insights in Vercel project settings
# (packages @vercel/analytics and @vercel/speed-insights are already wired in the app)
