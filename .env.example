# Copy to `.env` locally (never commit `.env`). In Vercel: Project → Settings → Environment Variables.

# Neon Postgres — paste your full connection string from the Neon dashboard.
# Format: postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require"

# Google account used to sign in to Neon (for your team’s reference only; not used by the app)
NEON_ACCOUNT_EMAIL="privekian8@gmail.com"

# NextAuth (set in Vercel for production)
# Production site: use the canonical URL with no trailing slash, e.g. https://www.kianprive.com
# NEXTAUTH_URL="https://www.kianprive.com"
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32-or-node-crypto"

# Acuity Scheduling (Integrations → API in Acuity dashboard)
# ACUITY_USER_ID="your_numeric_user_id"
# ACUITY_API_KEY="your_api_key"
# ACUITY_SCHEDULER_BASE_URL="https://YourBusiness.as.me"
# ACUITY_SCHEDULING_ENABLED="true"
# ACUITY_BOOK_AS_ADMIN="true"
# Optional per-service overrides: ACUITY_TYPE_NUTRITION=19112766

# Secure notifications (Resend)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="KIAN Prive <contact@keepingitallnatural.com>"
# BOOKING_REPORT_EMAIL="contact@keepingitallnatural.com"
# PEPTIDE_INTAKE_REPORT_EMAIL="contact@keepingitallnatural.com"
# CELEXO_INTAKE_REPORT_EMAIL="contact@keepingitallnatural.com"
# WELLNESS_HUB_INTAKE_REPORT_EMAIL="contact@keepingitallnatural.com,millenniumedgemed@gmail.com"
# (Dr. Carmen Ramirez also always receives Wellness Hub intake alerts at millenniumedgemed@gmail.com)

# Wellness Tech product-cost settlement (after patient pays via Authorize.net)
# Patient charge settles 100% to KIAN. App calculates wholesale cost and emails a PO for that amount.
# You ACH/wire Wellness Tech the cost, keep the rest (minus card fees). Mark paid in Admin → Vendors.
# WELLNESS_TECH_VENDOR_NAME="Wellness Tech"
# WELLNESS_TECH_VENDOR_EMAIL="orders@wellnesstech.example"
# WELLNESS_TECH_VENDOR_CONTACT="Fulfillment"
# WELLNESS_TECH_AUTO_EMAIL_PO="true"
# Also assign this vendor (or any vendor) + wholesale cost on clinical products in Admin.
#
# Push paid product orders to Wellness Tech Distribution (same secret as that site).
# KIAN stays the merchant of record. Distribution then places the RxHere Partner API order.
# WT_API_URL="https://www.thewellnesstech.com"
# WT_PARTNER_ORDER_SECRET="same-secret-as-wellness-tech"
# WELLNESS_TECH_API_URL is accepted as an alias of WT_API_URL.
# Status callbacks from Wellness Tech hit POST /api/webhooks/wellness-tech-order with the same secret.

# RxHere compounding pharmacy (formulary import: node scripts/import-rxhere-formulary.mjs)
# SKUs match Wellness Tech / Partner API catalog identifiers (no RXH- prefix).
# RXHERE_VENDOR_NAME="RxHere"
# RXHERE_VENDOR_EMAIL="info@rxhere.com"
# RXHERE_VENDOR_PHONE="(848) 379-4373"
# RXHERE_VENDOR_CONTACT="RxHere Orders"

# Lab prescription / requisition (when patient books blood work)
# Paste the email from your Wellness Tech lab card here:
# LAB_PRESCRIPTION_EMAIL="lab-orders@example.com"
# LAB_ORDERING_PHYSICIAN_NAME="Chyle Beaird, M.D."
# LAB_ORDERING_PHYSICIAN_NPI=""
# LAB_ORDERING_CLINIC_NAME="KIAN Privé"

# Wellness Hub → KIAN Privé intake webhook
# WELLNESS_HUB_INTAKE_SECRET="generate-a-long-random-string"
# Partner clinic sites (Facial Design / 4everglow) → POST /api/intake/partner
# Must match KIAN_PARTNER_INTAKE_SECRET on each partner site (docker-compose / Vercel).
PARTNER_INTAKE_SECRET="kian-partner-intake-dev-secret-2026"
# FACIAL_DESIGN_INTAKE_SECRET="optional-overrides-shared-secret"
# FOREVERGLOW_INTAKE_SECRET="optional-overrides-shared-secret"
# PARTNER_INTAKE_REPORT_EMAIL="consultations@kianprive.com"
# KIAN → partner clinic status webhooks (therapy.sent / therapy.paid / order.updated)
# Base URL only — KIAN posts to {URL}/api/kian/webhook with x-kian-partner-secret.
# FACIAL_DESIGN_WEBHOOK_URL="https://facialdesignstudio.com"
# FACIAL_DESIGN_WEBHOOK_SECRET="shared-with-partner-KIAN_WEBHOOK_SECRET"
# FOREVERGLOW_WEBHOOK_URL="https://4everglow.com"
# FOREVERGLOW_WEBHOOK_SECRET="shared-with-partner-KIAN_WEBHOOK_SECRET"
# PARTNER_WEBHOOK_SECRET="optional-shared-fallback-secret"

# Authorize.net (shop checkout + clinical therapy Accept & Pay)
# Leave unset (or THERAPY_PAYMENT_MODE=test) to simulate payments with Visa 4111 1111 1111 1111
# THERAPY_PAYMENT_MODE="test"
# AUTHORIZE_NET_API_LOGIN_ID=""
# AUTHORIZE_NET_TRANSACTION_KEY=""
# AUTHORIZE_NET_SIGNATURE_KEY=""
# AUTHORIZE_NET_ENV="sandbox"
# NEXT_PUBLIC_AUTHORIZE_NET_API_LOGIN_ID=""
# NEXT_PUBLIC_AUTHORIZE_NET_CLIENT_KEY=""
# Live production (set in Vercel / server env only — never commit real keys):
# THERAPY_PAYMENT_MODE="live"
# AUTHORIZE_NET_ENV="production"
# AUTHORIZE_NET_API_LOGIN_ID="your_api_login_id"
# AUTHORIZE_NET_TRANSACTION_KEY="your_transaction_key"
# AUTHORIZE_NET_SIGNATURE_KEY="your_signature_key"
# NEXT_PUBLIC_AUTHORIZE_NET_API_LOGIN_ID="your_api_login_id"
# NEXT_PUBLIC_AUTHORIZE_NET_CLIENT_KEY="your_public_client_key"
#
# 3D Secure / bank verification (Cardinal — enable Payer Authentication in Authorize.net first):
# CARDINAL_API_ID="your_cardinal_api_identifier"
# CARDINAL_API_KEY="your_cardinal_api_key"
# CARDINAL_ORG_UNIT="your_cardinal_org_unit_id"
# Note: Stripe may still be used for membership subscriptions if configured.

# Daily therapy refill charges (Vercel Cron sends Authorization: Bearer CRON_SECRET)
# CRON_SECRET="generate-a-long-random-string"

# Optional: enable Web Analytics + Speed Insights in Vercel project settings
# (packages @vercel/analytics and @vercel/speed-insights are already wired in the app)
